<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_bg"
    android:fitsSystemWindows="true">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/videoLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/playerTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_player_top_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="返回频道列表"
            app:backgroundTint="@color/player_secondary_bg"
            app:icon="@drawable/ic_back"
            app:iconSize="22dp"
            app:iconTint="@color/player_text"/>

        <TextView
            android:id="@+id/tvChannelName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/player_text"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/liveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_live_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_live"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="直播"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 左侧：亮度指示器（贴左边缘，竖向进度条） -->
    <LinearLayout
        android:id="@+id/brightnessHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_hud"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="18dp">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:contentDescription="亮度"
            app:srcCompat="@drawable/ic_brightness"
            app:tint="@color/player_text"/>

        <FrameLayout
            android:layout_width="4dp"
            android:layout_height="75dp"
            android:layout_marginTop="8dp">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/brightnessBar"
                android:layout_width="75dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:rotation="-90"
                app:indicatorColor="@color/player_text"
                app:trackColor="#33FFFFFF"
                app:trackThickness="4dp"
                app:trackCornerRadius="2dp"
                android:progress="50"/>
        </FrameLayout>
    </LinearLayout>

    <!-- 右侧：音量指示器（贴右边缘，竖向进度条） -->
    <LinearLayout
        android:id="@+id/volumeHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_hud"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="18dp">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:contentDescription="音量"
            app:srcCompat="@drawable/ic_volume"
            app:tint="@color/player_text"/>

        <FrameLayout
            android:layout_width="4dp"
            android:layout_height="75dp"
            android:layout_marginTop="8dp">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/volumeBar"
                android:layout_width="75dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:rotation="-90"
                app:indicatorColor="@color/player_button_bg"
                app:trackColor="#33FFFFFF"
                app:trackThickness="4dp"
                app:trackCornerRadius="2dp"
                android:progress="50"/>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/infoPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_control_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="正在观看"
                android:textColor="@color/player_muted"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvStreamInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/player_muted"
                android:textSize="12sp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/player_text"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReconnect"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="重连"
            android:textColor="@color/player_text"
            android:textSize="14sp"
            android:visibility="gone"
            app:backgroundTint="@color/player_secondary_bg"
            app:cornerRadius="24dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:minWidth="92dp"
            android:text="暂停"
            android:textColor="@color/player_button_text"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/player_button_bg"
            app:cornerRadius="24dp"/>
    </LinearLayout>


    <TextView
        android:id="@+id/tvUrl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>
